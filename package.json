{
  "name": "nabi-station",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @nabi/web dev",
    "nabi": "pnpm --filter @nabi/daemon nabi",
    "build": "pnpm typecheck && pnpm --filter @nabi/web build",
    "preview": "pnpm --filter @nabi/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "format": "prettier --write apps packages tests *.json *.ts *.yaml README.md",
    "format:check": "prettier --check apps packages tests *.json *.ts *.yaml README.md"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
